#!/bin/bash
# ghost-site-enable — install Ghost into an ISPConfig website's web folder.
#
# Ghost runs as an unprivileged `systemd --user` unit on a loopback port,
# behind the site's existing Apache vhost and Let's Encrypt certificate.
# It installs Ghost and nothing else: no owner account, no theme, no mail.
# The first person to open /ghost/ creates the owner.
set -euo pipefail

REGISTRY=/etc/ghost/sites.tsv
PORT_BASE=50001
DOMAIN=""; PORT=""; GHOST_VERSION=""; WIPE=0
DBNAME_OVERRIDE=""; DBUSER_OVERRIDE=""; DBPASS_OVERRIDE=""

die() { echo "ERROR: $*" >&2; exit 1; }

usage() {
  cat <<EOF
Usage: ghost-site-enable --domain <fqdn> [options]
  --domain <fqdn>     ISPConfig website to install into (required)
  --port <n>          Loopback port (default: next free from ${PORT_BASE})
  --ghost-version <n> Pin a Ghost major version (default: latest)
  --wipe              Clear the web folder first. Required when it holds
                      anything but ISPConfig defaults or a previous Ghost.
  --dbname <name>     Database to use (default: derived from the domain)
  --dbuser <user>     Database user (default: same as --dbname)
  --dbpass <pass>     Password for that user
EOF
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --domain) DOMAIN="$2"; shift 2;;
    --port) PORT="$2"; shift 2;;
    --ghost-version) GHOST_VERSION="$2"; shift 2;;
    --wipe) WIPE=1; shift;;
    --dbname) DBNAME_OVERRIDE="$2"; shift 2;;
    --dbuser) DBUSER_OVERRIDE="$2"; shift 2;;
    --dbpass) DBPASS_OVERRIDE="$2"; shift 2;;
    *) usage;;
  esac
done
[ -n "$DOMAIN" ] || usage
[ "$(id -u)" = 0 ] || die "must run as root"

# The database name and user reach SQL that runs as root, and MySQL cannot
# parameterise identifiers — validation is the only defence. These values come
# from the panel via sshcon, so they are external input, not our own.
for pair in "name:${DBNAME_OVERRIDE}" "user:${DBUSER_OVERRIDE}"; do
  what="${pair%%:*}"; val="${pair#*:}"
  [ -n "$val" ] || continue
  case "$val" in
    *[!A-Za-z0-9_]*) die "database ${what} may contain only letters, digits and underscore: '${val}'";;
  esac
  [ "${#val}" -le 64 ] || die "database ${what} is longer than 64 characters: '${val}'"
done

# ---- resolve the site from ISPConfig ----
read -r DOMAIN_ID DOCROOT SYSUSER SYSGROUP < <(
  mysql -N -B -e "SELECT domain_id,document_root,system_user,system_group
                  FROM dbispconfig.web_domain
                  WHERE domain='${DOMAIN}' AND active='y';" ) \
  || die "site '${DOMAIN}' not found or inactive in ISPConfig"
[ -n "${DOCROOT:-}" ] || die "site '${DOMAIN}' not found in ISPConfig"

SHELLUSER="$(mysql -N -B -e "SELECT username FROM dbispconfig.shell_user
                             WHERE parent_domain_id=${DOMAIN_ID} AND active='y' LIMIT 1;")"
[ -n "$SHELLUSER" ] || die "no active shell user for ${DOMAIN} — create one in ISPConfig first"

CHROOT="$(mysql -N -B -e "SELECT chroot FROM dbispconfig.shell_user
                          WHERE parent_domain_id=${DOMAIN_ID} LIMIT 1;")"
[ "$CHROOT" != "jailkit" ] || die "shell user '${SHELLUSER}' is jailkit-chrooted.
  systemd --user cannot reach into a jail (no XDG_RUNTIME_DIR).
  Set Chroot=None on this shell user in ISPConfig, then re-run."

UID_N="$(id -u "$SYSUSER")"
WEBDIR="${DOCROOT}/web"
UNITDIR="${DOCROOT}/.config/systemd/user"

# Resolve node as the TENANT sees it. Checking root's PATH proves nothing:
# ghost runs as the shell user, and the unit needs an absolute path.
NODE_BIN="$(su - "$SHELLUSER" -c 'command -v node' 2>/dev/null || true)"
[ -n "$NODE_BIN" ] || die "node is not on ${SHELLUSER}'s PATH"
su - "$SHELLUSER" -c 'command -v ghost' >/dev/null 2>&1 \
  || die "ghost-cli is not on ${SHELLUSER}'s PATH (npm i -g ghost-cli)"

# ---- allocate port ----
mkdir -p /etc/ghost
[ -f "$REGISTRY" ] || printf "# port\tuid\tsite\tdir\n" > "$REGISTRY"
EXISTING="$(awk -v d="$DOMAIN" -F'\t' '$3==d{print $1; exit}' "$REGISTRY")"
if [ -n "$EXISTING" ]; then
  if [ -z "$PORT" ]; then
    PORT="$EXISTING"
  elif [ "$PORT" != "$EXISTING" ]; then
    die "${DOMAIN} is registered on port ${EXISTING} but --port ${PORT} was given.
  Remove its row from ${REGISTRY} first if that is really what you want."
  fi
elif [ -z "$PORT" ]; then
  PORT=$PORT_BASE
  while awk -v p="$PORT" -F'\t' '$1==p{f=1} END{exit !f}' "$REGISTRY" || ss -ltn | grep -q ":${PORT} "; do
    PORT=$((PORT+1))
  done
fi
echo "==> ${DOMAIN}: user=${SYSUSER}(${UID_N}) shell=${SHELLUSER} port=${PORT}"

# ---- group + linger ----
getent group ghost-users >/dev/null || groupadd ghost-users
usermod -aG ghost-users "$SYSUSER"
usermod -aG ghost-users "$SHELLUSER"
loginctl enable-linger "$SYSUSER"

# ---- stop anything already serving this site ----
if [ -f "${UNITDIR}/ghost.service" ]; then
  su - "$SHELLUSER" -c "export XDG_RUNTIME_DIR=/run/user/${UID_N}; \
    export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${UID_N}/bus; \
    systemctl --user stop ghost.service" 2>/dev/null || true
fi

# ---- clear the web folder ----
# ghost-cli refuses ANY non-empty directory, and that includes .well-known —
# which must survive, or Let's Encrypt renewal fails silently ~60 days later.
KEEP=$(mktemp -d /tmp/ghostkit-keep.XXXXXX)
for k in .well-known error; do
  [ -e "${WEBDIR}/${k}" ] && mv "${WEBDIR}/${k}" "${KEEP}/" || true
done

if [ -n "$(ls -A "$WEBDIR" 2>/dev/null)" ]; then
  # Anything that is not an ISPConfig default or a previous Ghost is somebody's
  # actual site. Refuse to delete that without an explicit --wipe.
  UNEXPECTED=0
  for f in "$WEBDIR"/* "$WEBDIR"/.[!.]*; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in
      standard_index.html|index.html|favicon.ico|robots.txt|stats|webalizer|.htaccess) ;;
      content|versions|current|config.production.json|config.development.json|.ghost-cli|ghost) ;;
      *) UNEXPECTED=1; echo "    unexpected: $(basename "$f")" ;;
    esac
  done
  if [ "$UNEXPECTED" = 1 ] && [ "$WIPE" != 1 ]; then
    for k in "$KEEP"/* "$KEEP"/.[!.]*; do
      [ -e "$k" ] && mv "$k" "${WEBDIR}/" || true
    done
    rmdir "$KEEP" 2>/dev/null || true
    die "${WEBDIR} holds files that are not ISPConfig defaults or a Ghost install (listed above).
  Re-run with --wipe if you really mean to delete them."
  fi
  echo "==> clearing ${WEBDIR}"
  find "$WEBDIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
fi

chown "${SYSUSER}:${SYSGROUP}" "$WEBDIR"
chmod 755 "$WEBDIR"

# ---- unit dir. ISPConfig sets +i on the docroot; lift it only to create .config ----
if [ ! -d "$UNITDIR" ]; then
  chattr -i "$DOCROOT" 2>/dev/null || true
  mkdir -p "$UNITDIR"
  chown -R "${SYSUSER}:${SYSGROUP}" "${DOCROOT}/.config"
  chattr +i "$DOCROOT" 2>/dev/null || true
fi

# ---- database ----
DBNAME="${DBNAME_OVERRIDE:-$(echo "c1${DOMAIN}" | tr -cd '[:alnum:]' | cut -c1-32)}"
DBUSER="${DBUSER_OVERRIDE:-$DBNAME}"
PWFILE="/etc/ghost/${DBNAME}.dbpass"
if [ -n "$DBPASS_OVERRIDE" ]; then
  printf '%s' "$DBPASS_OVERRIDE" > "$PWFILE"; chmod 600 "$PWFILE"
elif [ ! -f "$PWFILE" ]; then
  openssl rand -base64 24 | tr -d '/+=' | head -c 24 > "$PWFILE"; chmod 600 "$PWFILE"
fi
DBPASS="$(cat "$PWFILE")"
# A password is a SQL string literal, so a quote or backslash in it would end
# the literal early — a broken install at best, injected SQL at worst. Doubling
# the quote and escaping the backslash is what MySQL expects.
DBPASS_ESC=$(printf '%s' "$DBPASS" | sed "s/\\\\/\\\\\\\\/g; s/'/''/g")
mysql <<SQL
CREATE DATABASE IF NOT EXISTS \`${DBNAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE USER IF NOT EXISTS '${DBUSER}'@'127.0.0.1' IDENTIFIED BY '${DBPASS_ESC}';
ALTER USER '${DBUSER}'@'127.0.0.1' IDENTIFIED BY '${DBPASS_ESC}';
GRANT ALL PRIVILEGES ON \`${DBNAME}\`.* TO '${DBUSER}'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL
echo "==> database ${DBNAME} ready"

# ---- install ----
# --process local is REQUIRED. Without it ghost-cli leaves process=systemd and
# every later `ghost` command shells out to `sudo systemctl`, which hangs
# forever on a password prompt the tenant cannot answer.
echo "==> installing Ghost ${GHOST_VERSION:-latest} as ${SHELLUSER}"
su - "$SHELLUSER" -c "cd '${WEBDIR}' && ghost install ${GHOST_VERSION} \
  --db mysql --dbhost 127.0.0.1 --dbuser '${DBUSER}' --dbpass '${DBPASS}' --dbname '${DBNAME}' \
  --url 'https://${DOMAIN}' --port ${PORT} \
  --process local \
  --no-setup-mysql --no-setup-nginx --no-setup-ssl --no-setup-systemd --no-setup-linux-user \
  --no-start --no-prompt"

# 600, not 640: ISPConfig puts the web server user in the client group, so
# group-read would hand Apache the database password.
chmod 600 "${WEBDIR}/config.production.json"

# Ghost emails a verification code on every staff sign-in. With no mail
# configured that makes sign-in fail outright, locking the owner out of their
# own site. Off until mail exists; the setup instructions say how to restore it.
python3 - "$WEBDIR/config.production.json" <<'PY'
import io, json, sys
p = sys.argv[1]
d = json.load(io.open(p))
d.setdefault("security", {})["staffDeviceVerification"] = False
io.open(p, "w").write(json.dumps(d, indent=2))
PY
chown "${SYSUSER}:${SYSGROUP}" "${WEBDIR}/config.production.json"
chmod 600 "${WEBDIR}/config.production.json"

# ---- restore what had to be moved out of the way ----
for k in "$KEEP"/* "$KEEP"/.[!.]*; do
  [ -e "$k" ] && mv "$k" "${WEBDIR}/" || true
done
rmdir "$KEEP" 2>/dev/null || true

# ---- systemd user unit ----
mkdir -p "$UNITDIR"
cat > "${UNITDIR}/ghost.service" <<UNIT
[Unit]
Description=Ghost CMS - ${DOMAIN}
Documentation=https://ghost.org/docs/

[Service]
Type=simple
WorkingDirectory=${WEBDIR}
Environment="NODE_ENV=production"
ExecStart=${NODE_BIN} current/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
UNIT
chown "${SYSUSER}:${SYSGROUP}" "${UNITDIR}/ghost.service"
chmod 644 "${UNITDIR}/ghost.service"

su - "$SHELLUSER" -c "export XDG_RUNTIME_DIR=/run/user/${UID_N}; \
  export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${UID_N}/bus; \
  systemctl --user daemon-reload && systemctl --user enable --now ghost.service"

# ---- registry ----
# Rewrite the row rather than appending only when absent: the port or the
# directory can change, and a stale row sends every later lookup to the
# wrong place while looking perfectly healthy.
TMPREG="$(mktemp)"
awk -v d="$DOMAIN" -F'\t' '$3!=d' "$REGISTRY" > "$TMPREG"
printf "%s\t%s\t%s\t%s\n" "$PORT" "$UID_N" "$DOMAIN" "$WEBDIR" >> "$TMPREG"
mv "$TMPREG" "$REGISTRY"
chmod 644 "$REGISTRY"

INSTALLED="$(su - "$SHELLUSER" -c "cd '${WEBDIR}' && node -e \"console.log(require('./current/package.json').version)\"" 2>/dev/null || echo unknown)"
echo "==> Ghost ${INSTALLED} installed in ${WEBDIR} on port ${PORT}"
